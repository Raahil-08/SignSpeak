{
  "buildCommand": "pip install -r requirements-vercel.txt",
  "outputDirectory": ".",
  "python": {
    "version": "3.11"
  },
  "functions": {
    "app.py": {
      "runtime": "python3.11",
      "memory": 512
    }
  },
  "ignoreCommand": "git check-ignore -q $FILE || exit 0",
  "env": {
    "PYTHONUNBUFFERED": "1"
  }
}
